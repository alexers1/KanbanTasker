@*
   Create / edit a task. Works on a copy the parent hands in, so Cancel is a no-op.
   Attachments are path references (a file or folder on a PC) — view/add/remove them
   here; you open the referenced path yourself in your PC's file manager.
*@

<div class="modal-backdrop" @onclick="OnCancel">
    <div class="modal glass" @onclick:stopPropagation="true">
        <div class="modal-head">
            <h2 class="modal-title">@(Task.Id == 0 ? "New task" : "Edit task")</h2>
            <button class="btn icon subtle" @onclick="OnCancel" title="Close">✕</button>
        </div>

        <div class="field">
            <label>Title</label>
            <input class="input" @bind="Task.Title" @bind:event="oninput" placeholder="What needs doing?" />
        </div>

        <div class="field">
            <label>Description</label>
            <textarea class="textarea" @bind="Task.Description" placeholder="Details…"></textarea>
        </div>

        <div class="form-row">
            <div class="field">
                <label>Column</label>
                <select class="select" @bind="Task.Category">
                    @foreach (var c in Columns)
                    {
                        <option value="@c">@c</option>
                    }
                </select>
            </div>
            <div class="field">
                <label>Priority</label>
                <select class="select" @bind="Task.ColorKey">
                    <option value="Low">Low</option>
                    <option value="Medium">Medium</option>
                    <option value="High">High</option>
                </select>
            </div>
        </div>

        <div class="form-row">
            <div class="field">
                <label>Due date</label>
                <input class="input" type="date" @bind="DueDateValue" />
            </div>
            <div class="field">
                <label>Tags <span style="font-weight:400;opacity:.7">(comma separated)</span></label>
                <input class="input" @bind="Task.Tags" placeholder="design, urgent" />
            </div>
        </div>

        <div class="field">
            <label>Attachments <span style="font-weight:400;opacity:.7">(links to files/folders on a PC — open them in your file manager)</span></label>
            @foreach (var a in AttachmentList)
            {
                <div class="attach-row">
                    <span class="attach-path" title="@a">@a</span>
                    <button type="button" class="btn icon subtle" @onclick="() => RemoveAttachment(a)" title="Remove">✕</button>
                </div>
            }
            <div style="display:flex;gap:8px;margin-top:6px">
                <input class="input" @bind="newAttachment" @bind:event="oninput" placeholder="PC-NAME\D:\path\to\file-or-folder" />
                <button type="button" class="btn" @onclick="AddAttachment">Add</button>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(Error))
        {
            <div class="modal-error">@Error</div>
        }

        <div class="modal-foot">
            <button class="btn subtle" @onclick="OnCancel">Cancel</button>
            <button class="btn accent" @onclick="Save">Save</button>
        </div>
    </div>
</div>

@code {
    [Parameter] public TaskDTO Task { get; set; } = new();
    [Parameter] public List<string> Columns { get; set; } = new();
    [Parameter] public EventCallback<TaskDTO> OnSave { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private string Error = "";
    private string newAttachment = "";

    // Attachments are stored as a ';'-separated string of "MACHINE\path" references.
    private List<string> AttachmentList =>
        string.IsNullOrWhiteSpace(Task.Attachments)
            ? new()
            : Task.Attachments.Split(';', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList();

    private void AddAttachment()
    {
        var v = newAttachment?.Trim();
        if (string.IsNullOrEmpty(v)) return;
        var list = AttachmentList;
        if (!list.Contains(v)) list.Add(v);
        Task.Attachments = string.Join(";", list);
        newAttachment = "";
    }

    private void RemoveAttachment(string a)
    {
        var list = AttachmentList;
        list.Remove(a);
        Task.Attachments = string.Join(";", list);
    }

    // Bridge the string DueDate (yyyy-MM-dd stored) to the <input type=date>.
    private DateTime? DueDateValue
    {
        get => DateTime.TryParse(Task.DueDate, out var d) ? d : null;
        set => Task.DueDate = value?.ToString("yyyy-MM-dd") ?? "";
    }

    private async System.Threading.Tasks.Task Save()
    {
        if (string.IsNullOrWhiteSpace(Task.Title))
        {
            Error = "Title is required.";
            return;
        }
        if (string.IsNullOrEmpty(Task.ColorKey)) Task.ColorKey = "Low";
        await OnSave.InvokeAsync(Task);
    }
}
