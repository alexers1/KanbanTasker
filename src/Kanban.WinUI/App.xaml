<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Kanban_WinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Kanban_WinUI">
    <Application.Resources>
        <ResourceDictionary
            xmlns:converters="using:Kanban_WinUI.Converters">
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- Other merged dictionaries here -->
            </ResourceDictionary.MergedDictionaries>

            <!-- Theme-aware ports of the original KanbanThemeDictionary brushes,
                 referenced by the dialogs (EditBoard, Settings, FirstRun, AppUpdated). -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <AcrylicBrush x:Key="PaneBackgroundAcrylicBrush"
                                  TintColor="#1F1F1F"
                                  TintOpacity="0.8"
                                  FallbackColor="#1F1F1F" />
                    <SolidColorBrush x:Key="RegionBrush" Color="#202020" />
                    <!-- Liquid glass, balanced like the Sedela dashboard reference: warm dark
                         panels that stay readable, transparency as a hint, subtle specular edge.
                         Plain translucent fills = cheap; the only blur is the window backdrop. -->
                    <!-- Real WinUI AcrylicBrush: in-app blur layer with luminosity blend,
                         so panels read as physical glass over the window backdrop -->
                    <AcrylicBrush x:Key="GlassSurfaceBrush"
                                  TintColor="#221E1C"
                                  TintOpacity="0.50"
                                  TintLuminosityOpacity="0.72"
                                  FallbackColor="#262220" />
                    <SolidColorBrush x:Key="GlassCardBrush" Color="#FFFFFF" Opacity="0.10" />
                    <LinearGradientBrush x:Key="GlassEdgeBrush" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0" Color="#26FFFFFF" />
                        <GradientStop Offset="1" Color="#12FFFFFF" />
                    </LinearGradientBrush>
                    <RadialGradientBrush x:Key="AmbientGlowPrimaryBrush"><GradientStop Offset="0" Color="#80C7341D" /><GradientStop Offset="1" Color="#00C7341D" /></RadialGradientBrush>
                    <RadialGradientBrush x:Key="AmbientGlowSecondaryBrush"><GradientStop Offset="0" Color="#524A1E11" /><GradientStop Offset="1" Color="#004A1E11" /></RadialGradientBrush>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <AcrylicBrush x:Key="PaneBackgroundAcrylicBrush"
                                  TintColor="#FCFCFC"
                                  TintOpacity="0.8"
                                  FallbackColor="#FCFCFC" />
                    <SolidColorBrush x:Key="RegionBrush" Color="#F3F3F3" />
                    <AcrylicBrush x:Key="GlassSurfaceBrush"
                                  TintColor="#FBFAF9"
                                  TintOpacity="0.45"
                                  TintLuminosityOpacity="0.80"
                                  FallbackColor="#F5F3F2" />
                    <SolidColorBrush x:Key="GlassCardBrush" Color="#FFFFFF" Opacity="0.72" />
                    <LinearGradientBrush x:Key="GlassEdgeBrush" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0" Color="#E8FFFFFF" />
                        <GradientStop Offset="1" Color="#1E000000" />
                    </LinearGradientBrush>
                    <RadialGradientBrush x:Key="AmbientGlowPrimaryBrush"><GradientStop Offset="0" Color="#38E8663C" /><GradientStop Offset="1" Color="#00E8663C" /></RadialGradientBrush>
                    <RadialGradientBrush x:Key="AmbientGlowSecondaryBrush"><GradientStop Offset="0" Color="#2AD9A05B" /><GradientStop Offset="1" Color="#00D9A05B" /></RadialGradientBrush>
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="PaneBackgroundAcrylicBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="RegionBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="GlassSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="GlassCardBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="GlassEdgeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="AmbientGlowPrimaryBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="AmbientGlowSecondaryBrush" Color="Transparent" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- Converters for bindings -->
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <converters:StringToColorConverter x:Key="StringToColorConverter" />
            <converters:TasksByCategoryConverter x:Key="TasksByCategoryConverter" />
            <converters:StringToTimeSpanConverter x:Key="StringToTimeSpanConverter" />
            <converters:CardCountConverter x:Key="cardCountConverter" />
            <converters:NullableDateTimeOffsetToBoolConverter x:Key="NullableDateTimeOffsetToBoolConverter" />
            <converters:StringToNullableDateTimeOffsetConverter x:Key="stringToDateConverter" />
            <converters:IsNullConverter x:Key="isNullConverter" />
            <converters:BoolToBrushConverter x:Key="BoolToBrushConverter" />
            <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
            <converters:DateToShortDateConverter x:Key="DateToShortDateConverter" />

            <!-- Compact icon-button styles used by the kanban card template and task flyout
                 (ported equivalents of the original KanbanThemeDictionary styles). -->
            <Style x:Key="CardHyperlinkButtonStyle" TargetType="HyperlinkButton">
                <Setter Property="Padding" Value="4" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            </Style>
            <Style x:Key="AppBarButtonCustomStyle" TargetType="AppBarButton">
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Width" Value="Auto" />
            </Style>
            <Style x:Key="SettingsHyperlinkButtonStyle" TargetType="HyperlinkButton">
                <Setter Property="Padding" Value="2" />
                <Setter Property="MinHeight" Value="0" />
            </Style>
            <!-- Subtle icon-only button (column header actions, theme toggle) -->
            <Style x:Key="IconButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="6" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <!-- Other app resources here -->
        </ResourceDictionary>
    </Application.Resources>
</Application>
