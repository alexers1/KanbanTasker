<ContentDialog
    x:Class="Kanban_WinUI.Views.Dialogs.BoardListDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:Kanban_WinUI.ViewModels"
    Background="{ThemeResource PaneBackgroundAcrylicBrush}"
    CornerRadius="8"
    Loaded="BoardListDialog_Loaded"
    mc:Ignorable="d">

    <Grid Width="420" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2">
                <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="Boards" />
                <TextBlock
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Manage your boards — select one or more to delete" />
            </StackPanel>
            <Button
                Grid.Column="1"
                VerticalAlignment="Top"
                Background="Transparent"
                BorderThickness="0"
                Click="CloseDialog_Click"
                ToolTipService.ToolTip="Close">
                <FontIcon FontSize="13" Glyph="&#xE711;" />
            </Button>
        </Grid>

        <!-- Board list -->
        <Grid Grid.Row="1">
            <TextBlock
                x:Name="NoBoardsTextBlock"
                Margin="0,8,0,0"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="No boards available"
                Visibility="Collapsed" />
            <ListView
                x:Name="BoardListView"
                MaxHeight="400"
                SelectionMode="Multiple">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="viewmodels:BoardViewModel">
                        <StackPanel Margin="0,8" Spacing="2">
                            <TextBlock FontWeight="SemiBold" Text="{x:Bind Board.Name, Mode=OneWay}" />
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                MaxLines="2"
                                Text="{x:Bind Board.Notes, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- Actions -->
        <StackPanel
            Grid.Row="2"
            Orientation="Horizontal"
            Spacing="8">
            <Button x:Name="DeleteItemsBtn" Content="Delete selected board(s)">
                <Button.Flyout>
                    <Flyout>
                        <StackPanel MaxWidth="320" Spacing="8">
                            <TextBlock FontWeight="SemiBold" Text="Delete boards?" />
                            <TextBlock
                                Text="The selected boards and all of their tasks will be deleted. Continue?"
                                TextWrapping="Wrap" />
                            <Button
                                Click="DeleteItemsBtn_Click"
                                Content="Yes, delete selected boards" />
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>
            <Button Click="CloseDialog_Click" Content="Close" />
        </StackPanel>
    </Grid>
</ContentDialog>
