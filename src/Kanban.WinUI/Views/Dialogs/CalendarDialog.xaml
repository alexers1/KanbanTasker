<ContentDialog
    x:Class="Kanban_WinUI.Views.Dialogs.CalendarDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Kanban_WinUI.Models"
    xmlns:textconverters="using:Kanban_WinUI.Converters"
    Background="{ThemeResource PaneBackgroundAcrylicBrush}"
    CornerRadius="8"
    Loaded="CalendarDialog_Loaded"
    mc:Ignorable="d">

    <ContentDialog.Resources>
        <textconverters:StringToColorConverter x:Key="stringToColorConvertor" />
        <x:Double x:Key="ContentDialogMaxWidth">1100</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">760</x:Double>
    </ContentDialog.Resources>

    <Grid MinWidth="680">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: title + live clock + close -->
        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2">
                <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="Task Calendar" />
                <TextBlock
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Pick a date to see the tasks due that day" />
            </StackPanel>
            <StackPanel
                Grid.Column="1"
                Margin="0,0,12,0"
                VerticalAlignment="Center">
                <TextBlock
                    x:Name="txtCurrentTime"
                    HorizontalAlignment="Right"
                    FontSize="20"
                    FontWeight="SemiBold"
                    Text="{x:Bind CalendarViewModel.CurrentTime.ToLongTimeString(), Mode=OneWay}" />
                <TextBlock
                    HorizontalAlignment="Right"
                    FontSize="11"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind CalendarViewModel.CurrentTime.ToLongDateString(), Mode=OneWay}" />
            </StackPanel>
            <Button
                Grid.Column="2"
                VerticalAlignment="Top"
                Background="Transparent"
                BorderThickness="0"
                Click="BtnClose_Click"
                ToolTipService.ToolTip="Close">
                <FontIcon FontSize="13" Glyph="&#xE711;" />
            </Button>
        </Grid>

        <!-- Body: calendar + tasks due on the selected day -->
        <Grid Grid.Row="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <CalendarView
                x:Name="TaskCalendarView"
                Grid.Column="0"
                BorderThickness="0"
                CalendarIdentifier="GregorianCalendar"
                IsGroupLabelVisible="True"
                IsOutOfScopeEnabled="True"
                SelectedDatesChanged="TaskCalendarView_SelectedDatesChanged"
                SelectionMode="Single" />

            <Grid Grid.Column="1" MinWidth="280">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock
                    FontSize="16"
                    FontWeight="SemiBold"
                    Text="{x:Bind CalendarViewModel.SelectedDateDisplay, Mode=OneWay}" />
                <TextBlock
                    Grid.Row="1"
                    Margin="0,8,0,0"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="No tasks due on this day"
                    Visibility="{x:Bind CalendarViewModel.HasNoResults, Mode=OneWay}" />
                <ListView
                    x:Name="lstView"
                    Grid.Row="1"
                    MaxHeight="380"
                    Margin="0,8,0,0"
                    IsItemClickEnabled="True"
                    ItemClick="LstView_ItemClick"
                    ItemsSource="{x:Bind CalendarViewModel.ScheduledTasks, Mode=OneWay}"
                    SelectionMode="None">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,8" />
                            <Setter Property="MinHeight" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:PresentationTask">
                            <Grid
                                Padding="10,8"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                ColumnSpacing="10"
                                CornerRadius="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Rectangle
                                    Width="4"
                                    Fill="{x:Bind ColorKey, Converter={StaticResource stringToColorConvertor}}"
                                    RadiusX="2"
                                    RadiusY="2" />
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    Text="{x:Bind TimeDue}" />
                                <StackPanel Grid.Column="2" Spacing="2">
                                    <TextBlock
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Text="{x:Bind Title}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        MaxLines="2"
                                        Text="{x:Bind Description}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>
    </Grid>
</ContentDialog>
