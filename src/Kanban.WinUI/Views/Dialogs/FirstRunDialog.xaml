<ContentDialog x:Class="Kanban_WinUI.Views.Dialogs.FirstRunDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource PaneBackgroundAcrylicBrush}"
    CornerRadius="4">
    <Grid>
        <StackPanel HorizontalAlignment="Center" Orientation="Vertical">
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Margin="0,0,0,8">
                <Image Height="50" Source="ms-appx:///Assets/Square44x44Logo.targetsize-256.png" Stretch="Uniform" />
                <TextBlock Margin="12,12,0,12" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" FontWeight="Bold" TextWrapping="Wrap">
                    <Run>Kanban Tasker</Run>
                </TextBlock>
            </StackPanel>
            <TextBlock Margin="0,0,0,12" HorizontalAlignment="Center" TextWrapping="Wrap">
                <Run>Welcome and thank you for downloading Kanban Tasker!</Run>
            </TextBlock>
            <TextBlock FontWeight="Bold" Text="Main Features:" TextDecorations="Underline" />
            <TextBlock Margin="0,0,0,12" Text="A simple Kanban Board application to organize the flow of your work and supports as many boards as you would like to create" TextWrapping="Wrap" />
            <TextBlock Text="- Multi-board support" />
            <TextBlock Text="- Add/remove columns" />
            <TextBlock Text="- Edit column names and max task limit on a board" />
            <TextBlock Text="- One-click SQL database backup to a .bak file" TextWrapping="Wrap" />
            <TextBlock Text="- Reminder notifications for tasks" />
            <TextBlock Text="- Mini task calendar that shows tasks with due dates" />
            <TextBlock Text="- Smooth drag and drop between columns" />
            <TextBlock Text="- Edit tasks using a side pane" />
            <TextBlock Text="- Input validation to avoid interruption" />
            <Button x:Name="btnCloseDialog" Margin="0,24,0,0" HorizontalAlignment="Stretch" Click="btnCloseDialog_Click" Content="Close" />
        </StackPanel>
    </Grid>
</ContentDialog>