<ContentDialog
    x:Class="Kanban_WinUI.Views.Dialogs.ConnectionErrorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Can't reach the Kanban server"
    PrimaryButtonText="Retry"
    SecondaryButtonText="Continue anyway"
    DefaultButton="Primary"
    mc:Ignorable="d">

    <StackPanel Width="460" Spacing="12">
        <TextBlock
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="The desktop client talks to the Kanban server directly over your local network. It couldn't reach it right now. Check that this PC is on the same network as the server, then confirm or correct the address below and Retry."
            TextWrapping="Wrap" />

        <TextBox
            x:Name="ErrorBox"
            Header="Error details"
            AcceptsReturn="True"
            IsReadOnly="True"
            IsSpellCheckEnabled="False"
            MaxHeight="120"
            TextWrapping="Wrap" />

        <Button Click="Copy_Click" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <FontIcon FontSize="14" Glyph="&#xE8C8;" />
                <TextBlock Text="Copy error" />
            </StackPanel>
        </Button>

        <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="110" />
            </Grid.ColumnDefinitions>
            <TextBox
                x:Name="IpBox"
                Header="Server IP address"
                PlaceholderText="192.168.5.2"
                TextChanged="Field_Changed" />
            <TextBox
                x:Name="PortBox"
                Grid.Column="1"
                Header="Port"
                PlaceholderText="5001"
                TextChanged="Field_Changed" />
        </Grid>

        <TextBlock
            x:Name="Preview"
            FontSize="12"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    </StackPanel>
</ContentDialog>
