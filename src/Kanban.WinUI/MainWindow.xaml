<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Kanban_WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Kanban_WinUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:Kanban_WinUI.ViewModels"
    Title="Kanban.WinUI"
    mc:Ignorable="d">
    <!-- WinUI3 Mica frosted glass (毛玻璃) for premium modern look and feel.
         Leverages Windows App SDK Mica backdrop.
         BaseAlt gives a nice tinted frosted effect especially in dark theme (matching original app). -->
    <!-- Liquid-glass look: DesktopAcrylic blurs whatever is actually BEHIND the window
         (desktop, other apps) — real glass, unlike Mica's wallpaper-only tint. -->
    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Modern WinUI3 TitleBar (content extends into it so Mica flows through the whole window) -->
        <TitleBar x:Name="AppTitleBar" Title="Kanban Tasker" Subtitle="WinUI 3">
            <TitleBar.LeftHeader>
                <Image x:Name="TitleBarIcon"
                       Width="20"
                       Height="20"
                       Margin="4,0,0,0"
                       VerticalAlignment="Center" />
            </TitleBar.LeftHeader>
            <TitleBar.RightHeader>
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <Button x:Name="CompactOverlayButton"
                            Style="{StaticResource IconButtonStyle}"
                            Click="CompactOverlay_Click"
                            ToolTipService.ToolTip="Compact overlay (picture-in-picture)">
                        <FontIcon x:Name="CompactOverlayIcon" FontSize="14" Glyph="&#xE8A7;" />
                    </Button>
                    <Button x:Name="ThemeToggleButton"
                            Style="{StaticResource IconButtonStyle}"
                            Click="ThemeToggle_Click"
                            ToolTipService.ToolTip="Switch light/dark theme">
                        <FontIcon x:Name="ThemeToggleIcon" FontSize="14" Glyph="&#xE708;" />
                    </Button>
                </StackPanel>
            </TitleBar.RightHeader>
        </TitleBar>

        <!-- 
            NavigationView for board list. Content hosted in Frame for BoardView etc.
        -->
        <!-- Ambient color field (reference-style warm glow) that the frosted panels blur through -->
        <Grid Grid.Row="1" IsHitTestVisible="False">
            <Ellipse Width="950" Height="750" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-280,-280" Opacity="0.5">
                <Ellipse.Fill><RadialGradientBrush><GradientStop Offset="0" Color="#C7341D" /><GradientStop Offset="1" Color="#00C7341D" /></RadialGradientBrush></Ellipse.Fill>
            </Ellipse>
            <Ellipse Width="750" Height="620" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-220,-160,0,0" Opacity="0.32">
                <Ellipse.Fill><RadialGradientBrush><GradientStop Offset="0" Color="#4A1E11" /><GradientStop Offset="1" Color="#004A1E11" /></RadialGradientBrush></Ellipse.Fill>
            </Ellipse>
        </Grid>

        <NavigationView x:Name="NavView"
                        Grid.Row="1"
                        IsBackButtonVisible="Collapsed"
                        ItemInvoked="NavView_ItemInvoked"
                        PaneDisplayMode="Left">
            <NavigationView.MenuItems>
                <!-- Boards will be populated dynamically from ViewModel in code (WinUI3 NavigationView limitation for simple binding in this setup) -->
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="New Board" Icon="Add" Tag="NewBoard" />
                <NavigationViewItem Content="Edit Board" Tag="EditBoard">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE70F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Delete Board" Tag="DeleteBoard">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE74D;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Board List" Tag="BoardList">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8FD;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Task Calendar" Tag="Calendar">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE787;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <NavigationView.Content>
                <!-- The Frame for page navigation (BoardView, etc.) -->
                <Frame x:Name="RootFrame" />
            </NavigationView.Content>
        </NavigationView>

        <!-- Global modern InfoBar for notifications (WinUI3 replacement for old InAppNotification) -->
        <InfoBar x:Name="GlobalInfoBar"
                 Grid.Row="1"
                 IsOpen="False"
                 Severity="Informational"
                 Title="Notification"
                 VerticalAlignment="Top"
                 Margin="12,12,12,0" />
    </Grid>
</Window>
